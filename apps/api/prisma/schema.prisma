generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  email        String         @unique @db.VarChar(254)
  passwordHash String?        @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  identities   AuthIdentity[]
  sessions     AuthSession[]

  @@map("users")
}

model AuthIdentity {
  provider        String @db.VarChar(32)
  providerSubject String @map("provider_subject") @db.VarChar(255)
  userId          String @map("user_id") @db.Uuid
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model AuthSession {
  tokenHash String    @id @map("token_hash") @db.Char(64)
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model OAuthAttempt {
  tokenHash      String   @id @map("token_hash") @db.Char(64)
  platform       String   @db.VarChar(16)
  isRegistration Boolean  @default(false) @map("is_registration")
  nonceHash      String   @map("nonce_hash") @db.Char(64)
  browserHash    String?  @map("browser_hash") @db.Char(64)
  verifier       String?  @db.VarChar(128)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz

  @@index([expiresAt])
  @@map("oauth_attempts")
}
